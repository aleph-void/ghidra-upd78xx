ins: "TABLE" is op0_7 = 0x48; op0_7 = 0xa8 {
    # C <- (PC+3+A), B <- (PC+4+A), PC being the address of the TABLE instruction
    local ptr:2 = inst_start + 3 + zext(A);
    BC = *:2 ptr;
}

