# sleigh specification file for NEC uPD78 series


################################################################
# Machine definitions                                          #
################################################################

define endian=little;
define alignment=1;
define space ram      type=ram_space      size=2  default;
define space register type=register_space size=1;

################################################################
# Registers                                                    #
################################################################


define register offset=0x00 size=1 [ A V C B E D L H EAL EAH];
define register offset=0x00 size=2 [ VA  BC  DE  HL  EA];
define register offset=0x10 size=1 [ A_ V_ C_ B_ E_ D_ L_ H_ EAL_ EAH_]; # Alternate registers
define register offset=0x10 size=2 [ VA_   BC_   DE_   HL_   EA_      ]; # Alternate registers
define register offset=0x20 size=2 [ PC SP];

# Flag bits

define register offset=0x30 size=1 [ PSW ];
@define CY_flag     "PSW[0,1]"  # C: Carry
@define L0_flag     "PSW[2,1]"  #
@define L1_flag     "PSW[3,1]"  #
@define HC_flag     "PSW[4,1]"  # HC: Half carry
@define SK_flag     "PSW[5,1]"  # SK: Skip flag, skips the next instruction
@define Z_flag      "PSW[6,1]"  # Z: Zero

# Control registers
define register offset=0x40 size=1 [PORTA PORTB PORTC PORTD PORTF MA MB MC MCC MF MM TM0 TM1 TMM ETMM EOM ANM CR0 CR1 CR2 CR3 TXB RXB SMH SML MKH MKL ZCM]; # Mode control registers
# 16-bit control registers
define register offset=0x60 size=2 [ETM0 ETM1 ECNT ECPT]; # 16bit mode control registers

# Interrupt flags
define register offset=0xA0 size=1 [NMI FT0 FT1 F1 F2 FE0 FE1 FEIN FAD FSR FST ER OV AN4 AN5 AN6 AN7 SB];

define register offset=0xF0 size=4 contextreg;
define context contextreg
    # Set on an instruction that the preceding instruction may skip, so that the
    # SK flag check is emitted for it. The call instructions set it on their
    # fall-through, since the next instruction is the one that would be skipped 
    # in the case that a RETS instruction was executed.
    possibleSkip = (0,0) noflow
;

################################################################
# Tokens                                                       #
################################################################

define token opbyte (8)
    op0_7   = (0,7)
    op0_3   = (0,3)
    op0_4   = (0,4)
    op1_7   = (1,7)
    op2_7   = (2,7)
    op3_6   = (3,6)
    op3_7   = (3,7)
    op4_7   = (4,7)
    op5_7   = (5,7)
    op6_7   = (6,7)

    r_0_2   = (0,2)
    r1_0_2  = (0,2)
    r2_0_1  = (0,1)

    rpa_0_2  = (0,2)
    rpa1_0_1 = (0,1)
    rpa2_0_2 = (0,2)
    rpa3_0_3 = (0,3)

    rp_4_5  = (4,5)
    rp1_0_2 = (0,2)
    rp2_4_6 = (4,6)
    rp3_0_1 = (0,1)

    srl_0_4  = (0,4)
    srr_0_4  = (0,4)
    sr2l_0_2 = (0,2)
    sr2h_0_2 = (0,2)
    sr3_0    = (0,0)
    sr4_0    = (0,0)

    cr_0_1  = (0,1)

    fah_0_2 = (0,2)

    ta_0_4     = (0,4)
    jdisp1_0_5 = (0,5) signed

    f_0_2   = (0,2)
    irf_0_4 = (0,4)

    bit_0   = (0,0)
    bit_1   = (1,1)
    bit_2   = (2,2)
    bit_3   = (3,3)
    bit_4   = (4,4)
    bit_5   = (5,5)
    bit_7   = (7,7)

    bits0_2 = (0,2)
;

define token data8 (8)
   imm8  = (0,7)
   val8  = (0,7)
   sign8 = (7,7)
   simm8 = (0,7) signed
;

define token data16 (16)
   imm16  = (0,15)
   sign16 = (15,15)
   simm16 = (0,15) signed
;

# Working register offset
define token waAddr (8)
    waAddr8 = (0,7)
;

################################################################
# Variable tables                                              #
################################################################

attach variables [ r_0_2 ]  [ V   A   B C D E H L]; # r
attach variables [ r1_0_2 ] [ EAH EAL B C D E H L]; # r1
attach variables [ r2_0_1 ] [ V A B C]; # r2

attach variables [ rp_4_5 ] [ SP BC DE HL]; # rp

# sr: the special registers MOV sr,A can write (the low 5 bits of the S5..S0 code; ZCM is S5..S0 = 101000)
attach variables [ srl_0_4 ] [ PORTA PORTB PORTC PORTD _ PORTF MKH MKL ANM SMH SML EOM ETMM TMM _ _ MM MCC MA MB MC _ _ MF TXB _ TM0 TM1 _ _ _ _ ]; # SR low
# sr1: the special registers MOV A,sr1 can read (RXB is read-only, TXB write-only)
attach variables [ srr_0_4 ] [ PORTA PORTB PORTC PORTD _ PORTF MKH MKL ANM SMH _ EOM _ TMM _ _ _ _ _ _ _ _ _ _ _ RXB _ _ _ _ _ _ ]; # SR1 low
attach variables [ cr_0_1 ] [ CR0 CR1 CR2 CR3 ]; # cr registers
attach variables [ sr2l_0_2 ] [ PORTA PORTB PORTC PORTD _ PORTF MKH MKL]; # sr2 low
attach variables [ sr2h_0_2 ] [ ANM SMH _ EOM _ TMM _ _]; # sr2 high
attach variables [ sr3_0 ] [ ETM0 ETM1]; # sr3
attach variables [ sr4_0 ] [ ECNT ECPT]; # sr4

################################################################
# Psuedo Instructions                                          #
################################################################

define pcodeop disableMaskableInterrupts;
define pcodeop enableMaskableInterrupts;
define pcodeop halt;
define pcodeop stop;

################################################################
# Macros                                                       #
################################################################

# Flag behaviour follows Table 3-2 of the uPD78C1x user's manual: arithmetic sets Z, HC and CY;
# logical operations only Z; the skip tests also SK; INR/DCR set Z, HC and SK but leave CY alone.
# HC is the carry out of bit 3 (borrow into bit 3 for a subtraction; also for 16-bit operations).
# Operands are copied first, so a macro may be given a register, a memory operand or a constant.

macro add(op1, op2) {
    local x:1 = op1;
    local y:1 = op2;
    $(CY_flag) = carry(x, y);
    $(HC_flag) = (((x & 0xf) + (y & 0xf)) & 0x10) != 0;
    local r:1 = x + y;
    op1 = r;
    $(Z_flag) = (r == 0);
}

# op1 = op1 + op2 + CY
macro adc(op1, op2) {
    local x:1 = op1;
    local y:1 = op2;
    local c:1 = $(CY_flag);
    local w:2 = zext(x) + zext(y) + zext(c);
    $(CY_flag) = w > 0xff;
    $(HC_flag) = ((x & 0xf) + (y & 0xf) + c) > 0xf;
    local r:1 = w:1;
    op1 = r;
    $(Z_flag) = (r == 0);
}

# op1 = op1 + op2, skip if no carry
macro addNC(op1, op2) {
    add(op1, op2);
    $(SK_flag) = ($(CY_flag) == 0);
}

macro sub(op1, op2) {
    local x:1 = op1;
    local y:1 = op2;
    $(CY_flag) = x < y;
    $(HC_flag) = (x & 0xf) < (y & 0xf);
    local r:1 = x - y;
    op1 = r;
    $(Z_flag) = (r == 0);
}

# op1 = op1 - op2 - CY
macro sbb(op1, op2) {
    local x:1 = op1;
    local y:1 = op2;
    local c:1 = $(CY_flag);
    local xw:2 = zext(x);
    local yw:2 = zext(y) + zext(c);
    $(CY_flag) = xw < yw;
    $(HC_flag) = (x & 0xf) < ((y & 0xf) + c);
    local r:1 = x - y - c;
    op1 = r;
    $(Z_flag) = (r == 0);
}

# op1 = op1 - op2, skip if no borrow
macro subNB(op1, op2) {
    sub(op1, op2);
    $(SK_flag) = ($(CY_flag) == 0);
}

macro and(op1, op2) {
    local r = op1 & op2;
    op1 = r;
    $(Z_flag) = (r == 0);
}

macro or(op1, op2) {
    local r = op1 | op2;
    op1 = r;
    $(Z_flag) = (r == 0);
}

macro xor(op1, op2) {
    local r = op1 ^ op2;
    op1 = r;
    $(Z_flag) = (r == 0);
}

# The comparisons compute op1 - op2 (op1 - op2 - 1 for GT) only for its flags.
# GT: skip if no borrow, i.e. op1 > op2
macro gt(op1, op2) {
    local x:1 = op1;
    local y:1 = op2;
    $(CY_flag) = x <= y;
    $(HC_flag) = (x & 0xf) <= (y & 0xf);
    local r:1 = x - y - 1;
    $(Z_flag) = (r == 0);
    $(SK_flag) = x > y;
}

# LT: skip if borrow, i.e. op1 < op2
macro lt(op1, op2) {
    local x:1 = op1;
    local y:1 = op2;
    $(CY_flag) = x < y;
    $(HC_flag) = (x & 0xf) < (y & 0xf);
    $(Z_flag) = (x == y);
    $(SK_flag) = x < y;
}

macro ne(op1, op2) {
    local x:1 = op1;
    local y:1 = op2;
    $(CY_flag) = x < y;
    $(HC_flag) = (x & 0xf) < (y & 0xf);
    $(Z_flag) = (x == y);
    $(SK_flag) = x != y;
}

macro eq(op1, op2) {
    local x:1 = op1;
    local y:1 = op2;
    $(CY_flag) = x < y;
    $(HC_flag) = (x & 0xf) < (y & 0xf);
    $(Z_flag) = (x == y);
    $(SK_flag) = x == y;
}

# ON: skip if the logical product is not zero, OFF: skip if it is zero
macro on(op1, op2) {
    local r = op1 & op2;
    $(Z_flag) = (r == 0);
    $(SK_flag) = (r != 0);
}

macro off(op1, op2) {
    local r = op1 & op2;
    $(Z_flag) = (r == 0);
    $(SK_flag) = (r == 0);
}

# INR / DCR: skip on carry / borrow; CY is not affected
macro inr(op) {
    local x:1 = op;
    local r:1 = x + 1;
    op = r;
    $(HC_flag) = (x & 0xf) == 0xf;
    $(Z_flag) = (r == 0);
    $(SK_flag) = (x == 0xff);
}

macro dcr(op) {
    local x:1 = op;
    local r:1 = x - 1;
    op = r;
    $(HC_flag) = (x & 0xf) == 0;
    $(Z_flag) = (r == 0);
    $(SK_flag) = (x == 0);
}

# Decimal adjust (manual 14.6.10): +06 when the low digit is above 9 or HC is set, +60 when the
# high digit is above 9 (above 8 after a low-digit correction that carries), or CY is set.
macro daa() {
    local a:1 = A;
    local lo:1 = a & 0xf;
    local hi:1 = a >> 4;
    local cy:1 = $(CY_flag);
    local hc:1 = $(HC_flag);
    local lowfix:1 = (hc != 0) || (lo > 9);
    local hifix:1 = (cy != 0) || (hi > 9) || ((hc == 0) && (lo > 9) && (hi == 9));
    local adj:1 = (zext(lowfix) * 0x06) + (zext(hifix) * 0x60);
    local r:1 = a + adj;
    A = r;
    $(Z_flag) = (r == 0);
    $(HC_flag) = (lo + (adj & 0xf)) > 0xf;
    $(CY_flag) = hifix;
}

macro push16(val16) {
    SP = SP - 2;
    *:2 SP = val16;
}

macro pop16(ret16) {
    ret16 = *:2 SP;
    SP = SP + 2;
}

macro push8(val8) {
    SP = SP - 1;
    *:1 SP = val8;
}

macro pop8(ret8) {
    ret8 = *:1 SP;
    SP = SP + 1;
}

# 16-bit operations (EA with a register pair). HC is the carry out of bit 3, as for 8 bits.
macro add16(op1, op2) {
    local x:2 = op1;
    local y:2 = op2;
    $(CY_flag) = carry(x, y);
    $(HC_flag) = (((x & 0xf) + (y & 0xf)) & 0x10) != 0;
    local r:2 = x + y;
    op1 = r;
    $(Z_flag) = (r == 0);
}

macro adc16(op1, op2) {
    local x:2 = op1;
    local y:2 = op2;
    local c:2 = zext($(CY_flag));
    local w:4 = zext(x) + zext(y) + zext(c);
    $(CY_flag) = w > 0xffff;
    $(HC_flag) = ((x & 0xf) + (y & 0xf) + c) > 0xf;
    local r:2 = w:2;
    op1 = r;
    $(Z_flag) = (r == 0);
}

macro sub16(op1, op2) {
    local x:2 = op1;
    local y:2 = op2;
    $(CY_flag) = x < y;
    $(HC_flag) = (x & 0xf) < (y & 0xf);
    local r:2 = x - y;
    op1 = r;
    $(Z_flag) = (r == 0);
}

macro sbb16(op1, op2) {
    local x:2 = op1;
    local y:2 = op2;
    local c:2 = zext($(CY_flag));
    local xw:4 = zext(x);
    local yw:4 = zext(y) + zext(c);
    $(CY_flag) = xw < yw;
    $(HC_flag) = (x & 0xf) < ((y & 0xf) + c);
    local r:2 = x - y - c;
    op1 = r;
    $(Z_flag) = (r == 0);
}

macro gt16(op1, op2) {
    local x:2 = op1;
    local y:2 = op2;
    $(CY_flag) = x <= y;
    $(HC_flag) = (x & 0xf) <= (y & 0xf);
    local r:2 = x - y - 1;
    $(Z_flag) = (r == 0);
    $(SK_flag) = x > y;
}

macro lt16(op1, op2) {
    local x:2 = op1;
    local y:2 = op2;
    $(CY_flag) = x < y;
    $(HC_flag) = (x & 0xf) < (y & 0xf);
    $(Z_flag) = (x == y);
    $(SK_flag) = x < y;
}

macro ne16(op1, op2) {
    local x:2 = op1;
    local y:2 = op2;
    $(CY_flag) = x < y;
    $(HC_flag) = (x & 0xf) < (y & 0xf);
    $(Z_flag) = (x == y);
    $(SK_flag) = x != y;
}

macro eq16(op1, op2) {
    local x:2 = op1;
    local y:2 = op2;
    $(CY_flag) = x < y;
    $(HC_flag) = (x & 0xf) < (y & 0xf);
    $(Z_flag) = (x == y);
    $(SK_flag) = x == y;
}

################################################################
# Memory addresses and values                                  #
################################################################

Mem8: (imm16)     is imm16    { export *:1 imm16; }
Mem16: (imm16)    is imm16    { export *:2 imm16; }
Addr16: imm16     is imm16    { export *:1 imm16; }

################################################################
# Working register addresses                                   #
################################################################

waMem8: (V+waAddr8)  is V & waAddr8 {
    local hi:2 = zext(V);
    local ptr:2 = (hi << 8) + waAddr8;
    export *:1 ptr;
}

################################################################
# Relative jump destinations                                   #
################################################################

RelAddr6:       loc is jdisp1_0_5           [ loc = inst_next + jdisp1_0_5; ]       { export *:1 loc; }
RelAddr8_pos:   loc is imm8                 [ loc = inst_next + imm8; ]             { export *:1 loc; }
RelAddr8_neg:   loc is imm8                 [ loc = inst_next - 256 + imm8; ]       { export *:1 loc; }
faAddr:         faloc is fah_0_2; imm8      [ faloc = 0x800+(fah_0_2 << 8)+imm8; ]  {export *:1 faloc;}

################################################################
# Register pairs and register pair pointers                    #
################################################################

# r2 without V
r2_: r2_0_1 is (bit_0 != 0 | bit_1 != 0) & r2_0_1 { export r2_0_1; }
# r2 without V in second byte of mul/div/rotates:
r2_48: r2_0_1 is op0_7 = 0x48; (bit_0 != 0 | bit_1 != 0) & r2_0_1 { export r2_0_1; }

rp1: VA is rp1_0_2 = 0x0 & VA { export VA; }
rp1: BC is rp1_0_2 = 0x1 & BC { export BC; }
rp1: DE is rp1_0_2 = 0x2 & DE { export DE; }
rp1: HL is rp1_0_2 = 0x3 & HL { export HL; }
rp1: EA is rp1_0_2 = 0x4 & EA { export EA; }

rp2: SP is rp2_4_6 = 0x0 & SP { export SP; }
rp2: BC is rp2_4_6 = 0x1 & BC { export BC; }
rp2: DE is rp2_4_6 = 0x2 & DE { export DE; }
rp2: HL is rp2_4_6 = 0x3 & HL { export HL; }
rp2: EA is rp2_4_6 = 0x4 & EA { export EA; }

rp3: BC is rp3_0_1 = 0x1 & BC { export BC; }
rp3: DE is rp3_0_1 = 0x2 & DE { export DE; }
rp3: HL is rp3_0_1 = 0x3 & HL { export HL; }
# For 0x74 ... instructions addressing rp3
rp3_: rp3 is op0_7 = 0x74; rp3_0_1 != 0 & rp3 { export rp3; }

# Register pair pointers
rpa: (BC) is rpa_0_2 = 0x1 & BC                         { export *:1 BC; }
rpa: (DE) is rpa_0_2 = 0x2 & DE                         { export *:1 DE; }
rpa: (HL) is rpa_0_2 = 0x3 & HL                         { export *:1 HL; }
rpa: (DE+) is rpa_0_2 = 0x4 & DE                        { tmp = DE; DE = DE+1; export *:1 tmp; }
rpa: (HL+) is rpa_0_2 = 0x5 & HL                        { tmp = HL; HL = HL+1; export *:1 tmp; }
rpa: (DE-) is rpa_0_2 = 0x6 & DE                        { tmp = DE; DE = DE-1; export *:1 tmp; }
rpa: (HL-) is rpa_0_2 = 0x7 & HL                        { tmp = HL; HL = HL-1; export *:1 tmp; }

rpa1: (BC) is rpa1_0_1 = 0x1 & BC                       { export *:1 BC; }
rpa1: (DE) is rpa1_0_1 = 0x2 & DE                       { export *:1 DE; }
rpa1: (HL) is rpa1_0_1 = 0x3 & HL                       { export *:1 HL; }

rpa2: (BC) is rpa2_0_2 = 0x1 & bit_7 = 0 & BC           { export *:1 BC; }
rpa2: (DE) is rpa2_0_2 = 0x2 & bit_7 = 0 & DE           { export *:1 DE; }
rpa2: (HL) is rpa2_0_2 = 0x3 & bit_7 = 0 & HL           { export *:1 HL; }
rpa2: (DE+) is rpa2_0_2 = 0x4 & bit_7 = 0 & DE          { tmp = DE; DE= DE+1; export *:1 tmp;}
rpa2: (HL+) is rpa2_0_2 = 0x5 & bit_7 = 0 & HL          { tmp = HL; HL= HL+1; export *:1 tmp;}
rpa2: (DE-) is rpa2_0_2 = 0x6 & bit_7 = 0 & DE          { tmp = DE; DE= DE-1; export *:1 tmp;}
rpa2: (HL-) is rpa2_0_2 = 0x7 & bit_7 = 0 & HL          { tmp = HL; HL= HL-1; export *:1 tmp;}
rpa2: (HL+A) is rpa2_0_2 = 0x4 & bit_7 = 1 & HL & A     { ptr:2 = HL + zext(A); export *:1 ptr;}
rpa2: (HL+B) is rpa2_0_2 = 0x5 & bit_7 = 1 & HL & B     { ptr:2 = HL + zext(B); export *:1 ptr;}
rpa2: (HL+EA) is rpa2_0_2 = 0x6 & bit_7 = 1 & HL & EA   { ptr:2 = HL+EA; export *:1 ptr;}

rpa3: (DE) is rpa3_0_3 = 0x2 & DE                       { export *:2 DE; }
rpa3: (HL) is rpa3_0_3 = 0x3 & HL                       { export *:2 HL; }
rpa3: (DE++) is rpa3_0_3 = 0x4 & DE                     { tmp:2 = DE; DE = DE + 2; export *:2 tmp; }
rpa3: (HL++) is rpa3_0_3 = 0x5 & HL                     { tmp:2 = HL; HL = HL + 2; export *:2 tmp; }
rpa3: (HL+A) is rpa3_0_3 = 0xc & HL & A                 { ptr:2 = HL + zext(A); export *:2 ptr; }
rpa3: (HL+B) is rpa3_0_3 = 0xd & HL & B                 { ptr:2 = HL + zext(B); export *:2 ptr; }
rpa3: (HL+EA) is rpa3_0_3 = 0xe & HL & EA               { ptr:2 = HL + EA; export *:2 ptr; }

# Flags
flag: "CY" is f_0_2 = 0x2 { f:1 = $(CY_flag); export f; }
flag: "HC" is f_0_2 = 0x3 { f:1 = $(HC_flag); export f; }
flag: "Z"  is f_0_2 = 0x4 { f:1 = $(Z_flag); export f; }

# Interrupt request flags
irf: FT0    is irf_0_4 = 0x1 & FT0  { export FT0; }
irf: FT1    is irf_0_4 = 0x2 & FT1  { export FT1; }
irf: F1     is irf_0_4 = 0x3 & F1   { export F1; }
irf: F2     is irf_0_4 = 0x4 & F2   { export F2; }
irf: FE0    is irf_0_4 = 0x5 & FE0  { export FE0; }
irf: FE1    is irf_0_4 = 0x6 & FE1  { export FE1; }
irf: FEIN   is irf_0_4 = 0x7 & FEIN { export FEIN; }
irf: FAD    is irf_0_4 = 0x8 & FAD  { export FAD; }
irf: FSR    is irf_0_4 = 0x9 & FSR  { export FSR; }
irf: FST    is irf_0_4 = 0xa & FST  { export FST; }
irf: ER     is irf_0_4 = 0xb & ER   { export ER; }
irf: OV     is irf_0_4 = 0xc & OV   { export OV; }
irf: AN4    is irf_0_4 = 0x10 & AN4 { export AN4; }
irf: AN5    is irf_0_4 = 0x11 & AN5 { export AN5; }
irf: AN6    is irf_0_4 = 0x12 & AN6 { export AN6; }
irf: AN7    is irf_0_4 = 0x13 & AN7 { export AN7; }
irf: SB     is irf_0_4 = 0x14 & SB  { export SB; }

################################################################
# 14.6.1 8-bit data transfer instructions                      #
################################################################

# An instruction that follows a skip instruction (or the return address of a call: RETS skips the
# instruction after the call) is not executed when SK is set. SOFTI is never skipped.
:^instruction is possibleSkip=1 & op0_7 != 0x72 & instruction [ possibleSkip=0; ] {
    local skipped:1 = $(SK_flag);
    $(SK_flag) = 0;
    if (skipped != 0) goto inst_next;
    build instruction;
}

ins: "MOV" r1_0_2, A is op3_7=0x3 & r1_0_2 & A {
    r1_0_2 = A;
}

ins: "MOV" A, r1_0_2 is op3_7=0x1 & r1_0_2 & A {
    A = r1_0_2;
}

ins: "MOV" srl_0_4, A is op0_7 = 0x4D & A; op6_7 = 0x3 & srl_0_4 & bit_5=0 {
    srl_0_4 = A;
}

# S5..S0 = 101000. ZCM (zero-cross mode) is the one special register outside the 5-bit table.
ins: "MOV" ZCM, A is op0_7 = 0x4D & A; op0_7 = 0xE8 & ZCM {
    ZCM = A;
}

ins: "MOV" A, srr_0_4 is op0_7 = 0x4C; op6_7 = 0x3 & srr_0_4 & bit_5=0 & A {
    A = srr_0_4;
}

# CR0..CR3 (A/D conversion results, read-only): S5..S0 = 1000nn
ins: "MOV" A, cr_0_1 is op0_7 = 0x4C; op2_7 = 0x38 & cr_0_1 & A {
    A = cr_0_1;
}

ins: "MOV" r_0_2, Mem8 is op0_7 = 0x70; op3_7 = 0xD & r_0_2; Mem8 {
    r_0_2 = Mem8;
