ins: "NEI" r_0_2, imm8 is op0_7 = 0x74; op3_7 = 0x0d & r_0_2; imm8 [ possibleSkip = 1; globalset(inst_next,possibleSkip); ] {
    ne(r_0_2, imm8);
}

ins: "NEI" sr2l_0_2, imm8 is op0_7 = 0x64; op3_7 = 0x0d & sr2l_0_2; imm8 [ possibleSkip = 1; globalset(inst_next,possibleSkip); ] {
    ne(sr2l_0_2, imm8);
}

ins: "NEI" sr2h_0_2, imm8 is op0_7 = 0x64; op3_7 = 0x1d & sr2h_0_2; imm8 [ possibleSkip = 1; globalset(inst_next,possibleSkip); ] {
    ne(sr2h_0_2, imm8);
}

ins: "EQI" A, imm8 is op0_7 = 0x77; imm8 & A [ possibleSkip = 1; globalset(inst_next,possibleSkip); ] {
    eq(A, imm8);
}

ins: "EQI" r_0_2, imm8 is op0_7 = 0x74; op3_7 = 0x0f & r_0_2; imm8 [ possibleSkip = 1; globalset(inst_next,possibleSkip); ] {
    eq(r_0_2, imm8);
}

ins: "EQI" sr2l_0_2, imm8 is op0_7 = 0x64; op3_7 = 0x0f & sr2l_0_2; imm8 [ possibleSkip = 1; globalset(inst_next,possibleSkip); ] {
    eq(sr2l_0_2, imm8);
}

ins: "EQI" sr2h_0_2, imm8 is op0_7 = 0x64; op3_7 = 0x1f & sr2h_0_2; imm8 [ possibleSkip = 1; globalset(inst_next,possibleSkip); ] {
    eq(sr2h_0_2, imm8);
}

ins: "ONI" A, imm8 is op0_7 = 0x47; imm8 & A [ possibleSkip = 1; globalset(inst_next,possibleSkip); ] {
    on(A, imm8);
}

ins: "ONI" r_0_2, imm8 is op0_7 = 0x74; op3_7 = 0x09 & r_0_2; imm8 [ possibleSkip = 1; globalset(inst_next,possibleSkip); ] {
    on(r_0_2, imm8);
}

ins: "ONI" sr2l_0_2, imm8 is op0_7 = 0x64; op3_7 = 0x09 & sr2l_0_2; imm8 [ possibleSkip = 1; globalset(inst_next,possibleSkip); ] {
    on(sr2l_0_2, imm8);
}

ins: "ONI" sr2h_0_2, imm8 is op0_7 = 0x64; op3_7 = 0x19 & sr2h_0_2; imm8 [ possibleSkip = 1; globalset(inst_next,possibleSkip); ] {
    on(sr2h_0_2, imm8);
}

ins: "OFFI" A, imm8 is op0_7 = 0x57; imm8 & A [ possibleSkip = 1; globalset(inst_next,possibleSkip); ] {
    off(A, imm8);
}

ins: "OFFI" r_0_2, imm8 is op0_7 = 0x74; op3_7 = 0x0b & r_0_2; imm8 [ possibleSkip = 1; globalset(inst_next,possibleSkip); ] {
    off(r_0_2, imm8);
}

ins: "OFFI" sr2l_0_2, imm8 is op0_7 = 0x64; op3_7 = 0x0b & sr2l_0_2; imm8 [ possibleSkip = 1; globalset(inst_next,possibleSkip); ] {
    off(sr2l_0_2, imm8);
}

ins: "OFFI" sr2h_0_2, imm8 is op0_7 = 0x64; op3_7 = 0x1b & sr2h_0_2; imm8 [ possibleSkip = 1; globalset(inst_next,possibleSkip); ] {
    off(sr2h_0_2, imm8);
}

################################################################
# 14.6.6 Working register operation instructions               #
################################################################

ins: "ADDW" waMem8 is op0_7 = 0x74; op0_7 = 0xc0; waMem8 {
    add(A, waMem8);
}

ins: "ADCW" waMem8 is op0_7 = 0x74; op0_7 = 0xd0; waMem8 {
    adc(A, waMem8);
}

ins: "ADDNCW" waMem8 is op0_7 = 0x74; op0_7 = 0xa0; waMem8 [ possibleSkip = 1; globalset(inst_next,possibleSkip); ] {
    addNC(A, waMem8);
}

ins: "SUBW" waMem8 is op0_7 = 0x74; op0_7 = 0xe0; waMem8 {
    sub(A, waMem8);
}

ins: "SBBW" waMem8 is op0_7 = 0x74; op0_7 = 0xf0; waMem8 {
    sbb(A, waMem8);
}

ins: "SUBNBW" waMem8 is op0_7 = 0x74; op0_7 = 0xb0; waMem8 [ possibleSkip = 1; globalset(inst_next,possibleSkip); ] {
    subNB(A, waMem8);
}

ins: "ANAW" waMem8 is op0_7 = 0x74; op0_7 = 0x88; waMem8 {
    and(A, waMem8);
}

ins: "ORAW" waMem8 is op0_7 = 0x74; op0_7 = 0x98; waMem8 {
    or(A, waMem8);
}

ins: "XRAW" waMem8 is op0_7 = 0x74; op0_7 = 0x90; waMem8 {
    xor(A, waMem8);
}

ins: "GTAW" waMem8 is op0_7 = 0x74; op0_7 = 0xa8; waMem8 [ possibleSkip = 1; globalset(inst_next,possibleSkip); ] {
    gt(A, waMem8);
}

ins: "LTAW" waMem8 is op0_7 = 0x74; op0_7 = 0xb8; waMem8 [ possibleSkip = 1; globalset(inst_next,possibleSkip); ] {
    lt(A, waMem8);
}

ins: "NEAW" waMem8 is op0_7 = 0x74; op0_7 = 0xe8; waMem8 [ possibleSkip = 1; globalset(inst_next,possibleSkip); ] {
    ne(A, waMem8);
}

ins: "EQAW" waMem8 is op0_7 = 0x74; op0_7 = 0xf8; waMem8 [ possibleSkip = 1; globalset(inst_next,possibleSkip); ] {
    eq(A, waMem8);
}

ins: "ONAW" waMem8 is op0_7 = 0x74; op0_7 = 0xc8; waMem8 [ possibleSkip = 1; globalset(inst_next,possibleSkip); ] {
    on(A, waMem8);
}

ins: "OFFAW" waMem8 is op0_7 = 0x74; op0_7 = 0xd8; waMem8 [ possibleSkip = 1; globalset(inst_next,possibleSkip); ] {
    off(A, waMem8);
}

ins: "ANIW" waMem8, imm8 is op0_7 = 0x05; waMem8; imm8 {
    and(waMem8, imm8);
}

ins: "ORIW" waMem8, imm8 is op0_7 = 0x15; waMem8; imm8 {
    or(waMem8, imm8);
}

ins: "GTIW" waMem8, imm8 is op0_7 = 0x25; waMem8; imm8 [ possibleSkip = 1; globalset(inst_next,possibleSkip); ] {
    gt(waMem8, imm8);
}

ins: "LTIW" waMem8, imm8 is op0_7 = 0x35; waMem8; imm8 [ possibleSkip = 1; globalset(inst_next,possibleSkip); ] {
    lt(waMem8, imm8);
}

ins: "NEIW" waMem8, imm8 is op0_7 = 0x65; waMem8; imm8 [ possibleSkip = 1; globalset(inst_next,possibleSkip); ] {
    ne(waMem8, imm8);
}

ins: "EQIW" waMem8, imm8 is op0_7 = 0x75; waMem8; imm8 [ possibleSkip = 1; globalset(inst_next,possibleSkip); ] {
    eq(waMem8, imm8);
}

ins: "ONIW" waMem8, imm8 is op0_7 = 0x45; waMem8; imm8 [ possibleSkip = 1; globalset(inst_next,possibleSkip); ] {
    on(waMem8, imm8);
}

ins: "OFFIW" waMem8, imm8 is op0_7 = 0x55; waMem8; imm8 [ possibleSkip = 1; globalset(inst_next,possibleSkip); ] {
    off(waMem8, imm8);
}

################################################################
# 14.6.7 16-bit operation instructions                         #
################################################################

ins: "EADD" EA, r2_ is op0_7 = 0x70; op2_7 = 0x10 & r2_ & EA {
    local tmp:2 = zext(r2_);
    add16(EA, tmp);
}

ins: "DADD" EA, rp3_ is rp3_ & ... op2_7 = 0x31 & EA {
    add16(EA, rp3_);
}

ins: "DADC" EA, rp3_ is rp3_ & ... op2_7 = 0x35 & EA {
    adc16(EA, rp3_);
}

ins: "DADDNC" EA, rp3_ is rp3_ & ... op2_7 = 0x29 & EA [ possibleSkip = 1; globalset(inst_next,possibleSkip); ] {
    add16(EA, rp3_);
    $(SK_flag) = $(CY_flag) == 0;
}

ins: "ESUB" EA, r2_ is op0_7 = 0x70; op2_7 = 0x18 & r2_ & EA {
    local tmp:2 = zext(r2_);
    sub16(EA, tmp);
}

ins: "DSUB" EA, rp3_ is rp3_ & ... op2_7 = 0x39 & EA {
    sub16(EA, rp3_);
}

ins: "DSBB" EA, rp3_ is rp3_ & ... op2_7 = 0x3d & EA {
    sbb16(EA, rp3_);
}

ins: "DSUBNB" EA, rp3_ is rp3_ & ... op2_7 = 0x2d & EA [ possibleSkip = 1; globalset(inst_next,possibleSkip); ] {
    sub16(EA, rp3_);
    $(SK_flag) = $(CY_flag) == 0;
}

ins: "DAN" EA, rp3_ is rp3_ & ... op2_7 = 0x23 & EA {
    and(EA, rp3_);
}

ins: "DOR" EA, rp3_ is rp3_ & ... op2_7 = 0x27 & EA {
    or(EA, rp3_);
}

ins: "DXR" EA, rp3_ is rp3_ & ... op2_7 = 0x25 & EA {
    xor(EA, rp3_);
}

ins: "DGT" EA, rp3_ is rp3_ & ... op2_7 = 0x2b & EA [ possibleSkip = 1; globalset(inst_next,possibleSkip); ] {
    gt16(EA, rp3_);
}

ins: "DLT" EA, rp3_ is rp3_ & ... op2_7 = 0x2f & EA [ possibleSkip = 1; globalset(inst_next,possibleSkip); ] {
    lt16(EA, rp3_);
}

ins: "DNE" EA, rp3_ is rp3_ & ... op2_7 = 0x3b & EA [ possibleSkip = 1; globalset(inst_next,possibleSkip); ] {
    ne16(EA, rp3_);
}

ins: "DEQ" EA, rp3_ is rp3_ & ... op2_7 = 0x3f & EA [ possibleSkip = 1; globalset(inst_next,possibleSkip); ] {
    eq16(EA, rp3_);
}

ins: "DON" EA, rp3_ is rp3_ & ... op2_7 = 0x33 & EA [ possibleSkip = 1; globalset(inst_next,possibleSkip); ] {
    on(EA, rp3_);
}

ins: "DOFF" EA, rp3_ is rp3_ & ... op2_7 = 0x37 & EA [ possibleSkip = 1; globalset(inst_next,possibleSkip); ] {
    off(EA, rp3_);
}

################################################################
# 14.6.8 Multiplication / division instructions                #
################################################################

ins: "MUL" r2_48 is r2_48 & ... op2_7 = 0x0b {
    EA = zext(A) * zext(r2_48);
}

ins: "DIV" r2_48 is r2_48 & ... op2_7 = 0x0f {
    local divisor:2 = zext(r2_48);
    local dividend:2 = EA;
    EA = dividend / divisor;
    local rem:2 = dividend % divisor;
    r2_48 = rem:1;
}

################################################################
# 14.6.9 Increment / decrement instructions                    #
################################################################

ins: "INR" r2_ is op2_7 = 0x10 & r2_ [ possibleSkip = 1; globalset(inst_next,possibleSkip); ] {
    inr(r2_);
}

ins: "INRW" waMem8 is op0_7 = 0x20; waMem8 [ possibleSkip = 1; globalset(inst_next,possibleSkip); ] {
    inr(waMem8);
}

ins: "INX" rp_4_5 is op0_3 = 0x2 & op6_7 = 0x0 & rp_4_5 {
    rp_4_5 = rp_4_5 + 1;
}

ins: "INX" EA is op0_7 = 0xa8 & EA {
    EA = EA + 1;
}

ins: "DCR" r2_ is op2_7 = 0x14 & r2_ [ possibleSkip = 1; globalset(inst_next,possibleSkip); ] {
    dcr(r2_);
}

ins: "DCRW" waMem8 is op0_7 = 0x30; waMem8 [ possibleSkip = 1; globalset(inst_next,possibleSkip); ] {
    dcr(waMem8);
}

ins: "DCX" rp_4_5 is op0_3 = 0x3 & op6_7 = 0x0 & rp_4_5 {
    rp_4_5 = rp_4_5 - 1;
}

ins: "DCX" EA is op0_7 = 0xa9 & EA {
    EA = EA - 1;
}

################################################################
# 14.6.10 Other instructions                                   #
################################################################

ins: "DAA" is op0_7 = 0x61 {
    daa();
}

ins: "STC" is op0_7 = 0x48; op0_7 = 0x2b {
    $(CY_flag) = 1;
}

ins: "CLC" is op0_7 = 0x48; op0_7 = 0x2a {
    $(CY_flag) = 0;
}

ins: "NEGA" is op0_7 = 0x48; op0_7 = 0x3a {
    A = -A;
}

################################################################
# 14.6.11 Rotation / shift instructions                        #
################################################################

ins: "RLD" is op0_7 = 0x48; op0_7 = 0x38 {
    local val:1 = *:1 HL;
    nibA:1 = A & 0x0f;
    nibM:1 = val >> 4;
    *:1 HL = (val << 4) | nibA;
    A = (A & 0xf0) | nibM;
}

ins: "RRD" is op0_7 = 0x48; op0_7 = 0x39 {
    local val:1 = *:1 HL;
    nibA:1 = A & 0x0f;
    nibM:1 = val & 0x0f;
    *:1 HL = (val >> 4) | (nibA << 4);
    A = (A & 0xf0) | nibM;
}

ins: "RLL" r2_48 is r2_48 & ... op2_7 = 0x0d {
    local nextCY:1 = r2_48 >> 7;
    r2_48 = (r2_48 << 1) | $(CY_flag);
    $(CY_flag) = nextCY;
}

ins: "RLR" r2_48 is r2_48 & ... op2_7 = 0x0c {
    local nextCY:1 = r2_48 & 1;
    r2_48 = (r2_48 >> 1) | ($(CY_flag) << 7);
    $(CY_flag) = nextCY;
}

ins: "SLL" r2_48 is r2_48 & ... op2_7 = 0x09 {
    $(CY_flag) = r2_48 >> 7;
    r2_48 = r2_48 << 1;
}

ins: "SLR" r2_48 is r2_48 & ... op2_7 = 0x08 {
    $(CY_flag) = r2_48 & 1;
    r2_48 = r2_48 >> 1;
}

ins: "SLLC" r2_48 is r2_48 & ... op2_7 = 0x01 [ possibleSkip = 1; globalset(inst_next,possibleSkip); ] {
    $(CY_flag) = r2_48 >> 7;
    r2_48 = r2_48 << 1;
    $(SK_flag) = $(CY_flag);
}

ins: "SLRC" r2_48 is r2_48 & ... op2_7 = 0x00 [ possibleSkip = 1; globalset(inst_next,possibleSkip); ] {
    $(CY_flag) = r2_48 & 1;
    r2_48 = r2_48 >> 1;
    $(SK_flag) = $(CY_flag);
}

ins: "DRLL" EA is op0_7 = 0x48; op0_7 = 0xb4 & EA {
    local nextCY:1 = EA[15,1];
    EA = (EA << 1) | zext($(CY_flag));
    $(CY_flag) = nextCY;
}

ins: "DRLR" EA is op0_7 = 0x48; op0_7 = 0xb0 & EA {
    local nextCY:1 = EA[0,1];
    EA = (EA >> 1) | (zext($(CY_flag)) << 15);
    $(CY_flag) = nextCY;
}

ins: "DSLL" EA is op0_7 = 0x48; op0_7 = 0xa4 & EA {
    $(CY_flag) = EA[15,1];
    EA = EA << 1;
}

ins: "DSLR" EA is op0_7 = 0x48; op0_7 = 0xa0 & EA {
    $(CY_flag) = EA[0,1];
    EA = EA >> 1;
}

################################################################
# 14.6.12 Jump instructions                                    #
################################################################

ins: "JMP" Addr16 is op0_7 = 0x54; Addr16 {
    goto Addr16;
}

ins: "JB" is op0_7 = 0x21 {
    goto [BC];
}

ins: "JR" RelAddr6 is op6_7 = 0x3 & RelAddr6 {
    goto RelAddr6;
}

ins: "JRE" RelAddr8_pos is op0_7 = 0x4e; RelAddr8_pos {
    goto RelAddr8_pos;
}

ins: "JRE" RelAddr8_neg is op0_7 = 0x4f; RelAddr8_neg {
    goto RelAddr8_neg;
}

ins: "JEA" is op0_7 = 0x48; op0_7 = 0x28 {
    goto [EA];
}

################################################################
# 14.6.13 Call instructions                                    #
################################################################

ins: "CALL" Addr16 is op0_7 = 0x40; Addr16 [ possibleSkip = 1; globalset(inst_next,possibleSkip); ] {
    local tmp:2 = inst_next;
    push16(tmp);
    call Addr16;
}

ins: "CALB" is op0_7 = 0x48; op0_7 = 0x29 [ possibleSkip = 1; globalset(inst_next,possibleSkip); ] {
    local tmp:2 = inst_next;
    push16(tmp);
    call [BC];
}

ins: "CALF" faAddr is op3_7 = 0x0f ... & faAddr [ possibleSkip = 1; globalset(inst_next,possibleSkip); ] {
    local tmp:2 = inst_next;
    push16(tmp);
    call faAddr;
}

ins: "CALT" loc is op5_7 = 0x4 & ta_0_4 [ loc = 0x0080 + (ta_0_4 << 1); possibleSkip = 1; globalset(inst_next,possibleSkip); ] {
    local tmp:2 = inst_next;
    local ptr:2 = 0x0080 + (ta_0_4 << 1);
    local dest = *:2 ptr;
    push16(tmp);
    call [dest];
}

# The 87AD series pushes the address of the next instruction (the uCOM-87 pushed its own address).
:SOFTI is op0_7 = 0x72 [ possibleSkip = 1; globalset(inst_next,possibleSkip); ] {
    local tmp:2 = inst_next;
    push8(PSW);
    push16(tmp);
    $(SK_flag) = 0;
    $(L1_flag) = 0;
    $(L0_flag) = 0;
    call 0x0060;
}

################################################################
# 14.6.14 Return instructions                                  #
################################################################

ins: "RET" is op0_7 = 0xb8 {
    local tmp:2 = 0;
    pop16(tmp);
    return [tmp];
}

ins: "RETS" is op0_7 = 0xb9 {
    local tmp:2 = 0;
    pop16(tmp);
    $(SK_flag) = 1;
    return [tmp];
}

ins: "RETI" is op0_7 = 0x62 {
    local tmp:2 = 0;
    pop16(tmp);
    pop8(PSW);
    return [tmp];
}

################################################################
# 14.6.15 Skip instructions                                    #
################################################################

ins: "BIT" bits0_2, waMem8 is op3_7 = 0x0b & bits0_2; waMem8 [ possibleSkip = 1; globalset(inst_next,possibleSkip); ] {
    local wa:1 = waMem8;
    local mask:1 = 1 << bits0_2;
    $(SK_flag) = (wa & mask) != 0;
}

ins: "SK" flag is op0_7 = 0x48; op3_7 = 0x1 & flag [ possibleSkip = 1; globalset(inst_next,possibleSkip); ] {
    $(SK_flag) = flag;
}

ins: "SKN" flag is op0_7 = 0x48; op3_7 = 0x3 & flag [ possibleSkip = 1; globalset(inst_next,possibleSkip); ] {
    $(SK_flag) = !flag;
}

# SKIT / SKNIT also reset the tested request flag, except NMI.
ins: "SKIT" NMI is op0_7 = 0x48; op0_4 = 0x0 & op5_7 = 0x2 & NMI [ possibleSkip = 1; globalset(inst_next,possibleSkip); ] {
    $(SK_flag) = NMI != 0;
}

ins: "SKIT" irf is op0_7 = 0x48; op5_7 = 0x2 & irf [ possibleSkip = 1; globalset(inst_next,possibleSkip); ] {
    local f:1 = irf;
    $(SK_flag) = f != 0;
    irf = 0;
}

ins: "SKNIT" NMI is op0_7 = 0x48; op0_4 = 0x0 & op5_7 = 0x3 & NMI [ possibleSkip = 1; globalset(inst_next,possibleSkip); ] {
    $(SK_flag) = NMI == 0;
}

ins: "SKNIT" irf is op0_7 = 0x48; op5_7 = 0x3 & irf [ possibleSkip = 1; globalset(inst_next,possibleSkip); ] {
    local f:1 = irf;
    $(SK_flag) = f == 0;
    irf = 0;
}


################################################################
# 14.6.16 CPU control instructions                             #
################################################################

ins: "NOP" is op0_7 = 0x00 {
}

ins: "EI" is op0_7 = 0xaa {
    enableMaskableInterrupts();
}

ins: "DI" is op0_7 = 0xba {
    disableMaskableInterrupts();
}

ins: "HLT" is op0_7 = 0x48; op0_7 = 0x3b {
    halt();
}

ins: "STOP" is op0_7 = 0x48; op0_7 = 0xbb {
    stop();
}

################################################################
# Root constructors: stacking flags L1/L0                      #
################################################################

# Every instruction clears the stacking flags L1 and L0 (and SK, unless it is a skip instruction);
# only MVI A, MVI L and LXI H below set them. The skip flag is cleared by the skipped-instruction
# wrapper above and assigned by the skip instructions themselves.
:^ins is ins {
    $(L1_flag) = 0;
    $(L0_flag) = 0;
    build ins;
}

# Group A / group B stacking (manual 14.7): when MVI A,byte follows MVI A,byte (L1 set), or MVI L,byte /
# LXI H,word follow each other (L0 set), only the first one of the sequence has any effect.
:MVI A, imm8 is op0_7 = 0x69 & A; imm8 {
    local stacked:1 = $(L1_flag);
    $(L1_flag) = 1;
    $(L0_flag) = 0;
    if (stacked != 0) goto inst_next;
    A = imm8;
}

:MVI L, imm8 is op0_7 = 0x6f & L; imm8 {
    local stacked:1 = $(L0_flag);
    $(L0_flag) = 1;
    $(L1_flag) = 0;
    if (stacked != 0) goto inst_next;
    L = imm8;
}

:LXI HL, imm16 is op0_7 = 0x34 & HL; imm16 {
    local stacked:1 = $(L0_flag);
    $(L0_flag) = 1;
    $(L1_flag) = 0;
    if (stacked != 0) goto inst_next;
    HL = imm16;
}

