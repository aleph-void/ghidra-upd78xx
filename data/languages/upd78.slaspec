    ptr = DE + imm8;
    *:1 ptr = A;
}

ins: "STAX" (HL+imm8) is op0_7 = 0xbf; imm8 & HL {
    ptr = HL + imm8;
    *:1 ptr = A;
}

ins: "LDAX" rpa2 is op3_6 = 0x5 & rpa2_0_2 != 0x0 & rpa2 {
    A = rpa2;
}

