    local ptr = DE + imm8;
    A = *:1 ptr;
}

ins: "LDAX" (HL+imm8) is op0_7 = 0xaf; imm8 & HL {
    local ptr = HL + imm8;
    A = *:1 ptr;
}

ins: "EXX" is op0_7 = 0x11 {
    local tmp:2 = BC;
    BC = BC_;
    BC_ = tmp;
    tmp = DE;
    DE = DE_;
    DE_ = tmp;
    tmp = HL;
    HL = HL_;
    HL_ = tmp;
}

ins: "EXA" is op0_7 = 0x10 {
    local tmp:2 = VA;
    VA = VA_;
    VA_ = tmp;
    tmp = EA;
    EA = EA_;
    EA_ = tmp;
}

ins: "EXH" is op0_7 = 0x50 {
    local tmp:2 = HL;
    HL = HL_;
    HL_ = tmp;
}

ins: "BLOCK" is op0_7 = 0x31 {
    <loopstart>
    *:1 DE = *:1 HL;
    DE = DE + 1;
    HL = HL + 1;
    C = C - 1;
    if (C != 0xff) goto <loopstart>;
}

