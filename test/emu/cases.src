# ---------------- stacking flags L1 / L0 ----------------
case mvi_a_stacked
	mvi a,1
	mvi a,2
expect A 1
expect PSW 0x08
done
case mvi_a_after_other
	mvi a,1
	mvi b,5
	mvi a,2
expect A 2
expect B 5
expect PSW 0x08
done
case mvi_l_stacked
	mvi l,10h
	mvi l,20h
expect L 0x10
expect PSW 0x04
done
case lxi_h_after_mvi_l
	mvi l,33h
	lxi h,4444h
expect HL 0x0033
expect PSW 0x04
done
case lxi_h_twice
	lxi h,1111h
	lxi h,2222h
expect HL 0x1111
done
case mvi_a_then_l
	mvi a,1
	mvi l,2
expect A 1
expect L 2
expect PSW 0x04
done
case mvi_a_then_alu_clears
	mvi a,1
	adi a,0
	mvi a,3
expect A 3
done
case stacked_entry_points
	jmp start
entry:	mvi l,0
second:	mvi l,4
	ret
start:	call entry
	mov a,l
	mov e,a
	call second
	mov a,l
	mov d,a
done_:
	nop
set L 0xff
set E 0x77
set D 0x77
end done_
expect E 0x00
expect D 0x04
done

# ---------------- moves and memory ----------------
case mov_registers
	mov e,a
	mov a,b
	mov eah,a
	mov a,eal
set A 0x5a
set B 0x11
set EA 0x0034
expect E 0x5a
expect EAH 0x11
expect A 0x34
done
