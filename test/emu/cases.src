# Hand-computed p-code cases for the uPD78C1x module. See cases.py for the format.
# Flags in PSW: Z=40h SK=20h HC=10h L1=08h L0=04h CY=01h.  Registers not set start at 0.

# ---------------- arithmetic and flags ----------------
case adi_plain
	adi a,5
set A 0x10
expect A 0x15
expect PSW 0x00
done
case adi_carry
	adi a,20h
set A 0xf0
expect A 0x10
expect PSW 0x01
done
case adi_half_carry
	adi a,1
set A 0x0f
expect A 0x10
expect PSW 0x10
done
case adi_zero
	adi a,1
set A 0xff
expect A 0x00
expect PSW 0x51
done
case aci_carry_in
	aci a,0
set A 0x7f
set PSW 0x01
expect A 0x80
expect PSW 0x10
done
case aci_overflow
	aci a,0ffh
set A 0xff
set PSW 0x01
expect A 0xff
expect PSW 0x11
done
case sui_borrow
	sui a,20h
set A 0x10
expect A 0xf0
expect PSW 0x01
done
case sui_half_borrow
	sui a,1
set A 0x10
expect A 0x0f
expect PSW 0x10
done
case sui_zero
	sui a,33h
set A 0x33
expect A 0x00
expect PSW 0x40
done
case sbi_borrow_in
	sbi a,5
set A 0x05
set PSW 0x01
expect A 0xff
expect PSW 0x11
done
case sbb_reg_a
	sbb b,a
set B 0x10
set A 0x01
set PSW 0x01
expect B 0x0e
expect PSW 0x10
done
case add_a_reg_wrap
	add a,e
set A 0x80
set E 0x80
expect A 0x00
expect PSW 0x41
done
case add_adc_16bit
	mov a,e
	add l,a
	mov a,d
	adc h,a
set DE 0x0101
set HL 0x12ff
expect HL 0x1400
expect PSW 0x00
done
case ana_keeps_cy_hc
	ana a,e
set A 0xf0
set E 0x3c
set PSW 0x11
expect A 0x30
expect PSW 0x11
done
case ora_zero
	ora a,e
set PSW 0x01
expect A 0x00
expect PSW 0x41
done
case xra_self
	xra a,a
set A 0x5a
set PSW 0x10
expect A 0x00
expect PSW 0x50
done
case ani_imm
	ani a,0fh
set A 0xaa
expect A 0x0a
expect PSW 0x00
done
case ori_register
	ori c,0f0h
set C 0x0f
set A 0x01
expect C 0xff
expect A 0x01
done
case xri_register
	xri d,0fh
set D 0xff
expect D 0xf0
done
case sub_reg_a_borrow
	sub e,a
set E 0x05
set A 0x07
expect E 0xfe
expect PSW 0x11
done
case dadd_wrap
	dadd ea,b
set EA 0xffff
set BC 0x0001
expect EA 0x0000
expect PSW 0x51
done
case dadc_carry_in
	dadc ea,d
set EA 0x00ff
set DE 0x0100
set PSW 0x01
expect EA 0x0200
expect PSW 0x10
done
case dsub_half_borrow
	dsub ea,h
set EA 0x0100
set HL 0x0001
expect EA 0x00ff
expect PSW 0x10
done
case dsbb_borrow_in
	dsbb ea,b
set EA 0x1000
set BC 0x1000
set PSW 0x01
expect EA 0xffff
expect PSW 0x11
done
case dan_dor_dxr
	dan ea,b
	dor ea,d
	dxr ea,h
set EA 0xf0f0
set BC 0x0ff0
set DE 0x0f00
set HL 0x00ff
expect EA 0x0f0f
done
case eadd_esub
	eadd ea,a
	esub ea,b
set EA 0x00ff
set A 0x01
set B 0x01
expect EA 0x00ff
expect PSW 0x10
done
case mul_a_b
	mul b
set A 0x12
set B 0x10
expect EA 0x0120
expect PSW 0x00
done
case div_ea_c
	div c
set EA 0x0123
set C 0x10
expect EA 0x0012
expect C 0x03
done
case inx_dcx_keep_flags
	inx h
	dcx sp
	inx ea
	dcx ea
	inx b
set HL 0xffff
set EA 0x0000
set BC 0x00ff
set PSW 0x51
expect HL 0x0000
expect SP 0x7fff
expect EA 0x0000
expect BC 0x0100
expect PSW 0x51
done
case nega_cases
	nega
set A 0x01
expect A 0xff
done
case nega_80
	nega
set A 0x80
expect A 0x80
done
case daa_manual_example
	adi a,79h
	daa
set A 0x88
expect A 0x67
expect PSW 0x01
done
case daa_low_digit
	adi a,8
	daa
set A 0x09
expect A 0x17
expect PSW 0x00
done
case daa_wrap
	adi a,1
	daa
set A 0x99
expect A 0x00
expect PSW 0x51
done
case stc_clc
	stc
	nop
	clc
	stc
set PSW 0x50
expect PSW 0x51
done
case rld_manual_example
	rld
set A 0x01
set HL 0x2000
set ram:2000 0x53
expect A 0x05
expect ram:2000 0x31
done
case rrd_manual_example
	rrd
set A 0x01
set HL 0x2000
set ram:2000 0x53
expect A 0x03
expect ram:2000 0x15
done
case sll_keeps_z
	sll a
set A 0x81
set PSW 0x40
expect A 0x02
expect PSW 0x41
done
case slr_cy
	slr b
set B 0x03
expect B 0x01
expect PSW 0x01
done
case rll_through_carry
	rll a
set A 0x81
set PSW 0x01
expect A 0x03
expect PSW 0x01
done
case rlr_through_carry
	rlr c
set C 0x02
set PSW 0x01
expect C 0x81
expect PSW 0x00
done
case drll_drlr
	drll ea
	drlr ea
	drlr ea
set EA 0x8001
set PSW 0x00
expect EA 0x4000
expect PSW 0x01
done
case dsll_dslr
	dsll ea
	dslr ea
	dslr ea
set EA 0x8003
expect EA 0x0001
expect PSW 0x01
done

