	db 11h,22h,33h
	db 44h
set A 2
end endofcode2
expect C 0x33
expect B 0x44
done

# ---------------- flow ----------------
case jmp_jr_jre
	jmp l1
	mvi b,1
l1:	jr l2
	mvi c,1
l2:	jre l3
	mvi d,1
l3:	mvi e,9
set E 0
expect B 0
expect C 0
expect D 0
expect E 9
done
case jre_backward
	jmp go
back:	mvi h,5
	jmp fin
go:	jre back
fin:	nop
expect H 5
done
case loop_dcr_jr
	mvi b,0
loop:	dcr c
	jr loop
set C 2
expect C 0xff
done
case call_ret
	lxi sp,9000h
	call sub
	mvi d,5
	jmp fin
sub:	mvi e,7
	ret
fin:	nop
expect E 7
expect D 5
expect SP 0x9000
done
case rets_skips_after_call
	lxi sp,9000h
	call sub
	mvi d,5
	mvi h,9
	jmp fin
sub:	mvi e,7
	rets
fin:	nop
expect E 7
expect D 0
expect H 9
done
case call_stack_contents
	lxi sp,9000h
	call sub
	jmp fin
sub:	mov a,l
fin:	nop
end fin
expect SP 0x8ffe
expect ram:8ffe 0x06
expect ram:8fff 0x10
done
case jb_jea_calb
	lxi sp,9000h
	lxi b,tgt
	calb
	jea
tgt:	mvi d,3
	lxi b,tgt2
	jb
	mvi e,1
tgt2:	nop
expect D 3
expect E 0
done
case calt_calf
	lxi sp,9000h
	calt 82h
	calf 0900h
	jmp fin
	org 0900h
fn:	mvi h,6
	ret
	org 0100h
ct:	mvi d,4
	ret
fin:	nop
set ram:0082/2 0x0100
expect D 4
expect H 6
done
case softi_reti
	lxi sp,9000h
	softi
	mvi h,7
	jmp fin
	org 0060h
	mvi b,3
	reti
fin:	nop
set PSW 0x41
expect B 3
expect H 7
expect SP 0x9000
expect PSW 0x41
expect ram:8fff 0x41
done
case skip_not_applied_to_softi
	lxi sp,9000h
	sk cy
	softi
	mvi h,7
	jmp fin
	org 0060h
	mvi b,3
	reti
fin:	nop
set PSW 0x01
expect B 3
done
case jea_via_ea
	jea
	mvi b,1
tgt:	mvi c,2
set EA @tgt
expect B 0
expect C 2
done
